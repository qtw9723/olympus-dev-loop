# 이 파일을 .env.local로 복사하고 값을 채운다(.env.local은 git 추적 안 됨).
# Gmail 앱 비밀번호는 Google 계정 > 보안 > 앱 비밀번호에서 발급한다.
SMTP_SENDER="you@example.com"
SMTP_APP_PASSWORD=""   # Gmail 앱 비밀번호(공백 없이 16자)
# ↑ 같은 값이 최종 승인 답장 수신(IMAP, imap.gmail.com:993)에도 재사용된다.
#   답장 발신자 검증(위조 차단)은 APPROVE_FROM(config.sh, 기본=SMTP_SENDER)로 조정.
